# Copy to .env (gitignored). Only needed for the signed features; public markets and the mock
# exchange work without any of this.
NOVIG_ENV=qa
# Management key from the QA app: Profile → Settings → Novig API
NOVIG_KEY_ID=
NOVIG_PEM=keys/novig-api-key-management.pem
# Optional: an existing trading (subaccount) key. Otherwise Quickstart step 2 creates one in .novig/
NOVIG_TRADING_KEY_ID=
NOVIG_TRADING_PEM=
